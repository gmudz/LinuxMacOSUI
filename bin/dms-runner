#!/bin/bash
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export XDG_CURRENT_DESKTOP="niri"
export XDG_SESSION_TYPE="wayland"
export QT_QPA_PLATFORM="wayland"
export QT_QPA_PLATFORMTHEME="gtk3"
export QT_WAYLAND_DECORATION="adwaita"
export PATH="$HOME/.local/bin:$PATH"
export QT_PLUGIN_PATH="/usr/lib/x86_64-linux-gnu/qt6/plugins:$QT_PLUGIN_PATH"
export QML2_IMPORT_PATH="/usr/lib/x86_64-linux-gnu/qt6/qml:$HOME/.config/quickshell/dms:$QML2_IMPORT_PATH"
export QML_IMPORT_PATH="/usr/lib/x86_64-linux-gnu/qt6/qml:$HOME/.config/quickshell/dms:$QML_IMPORT_PATH"

exec $HOME/.local/bin/dms-bin run "$@"
