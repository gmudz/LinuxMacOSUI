{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "apple",
    "color": {
      "1": "white"
    },
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ›  ",
    "color": {
      "keys": "cyan",
      "title": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": " {1} (MacBook Edition)"
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "format": "{2} ({12})"
    },
    {
      "type": "host",
      "key": "Model"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "wm",
      "key": "Window Manager"
    },
    {
      "type": "theme",
      "key": "Theme"
    },
    {
      "type": "icons",
      "key": "Icons"
    },
    {
      "type": "font",
      "key": "Typography"
    },
    {
      "type": "cpu",
      "key": "Processor"
    },
    {
      "type": "gpu",
      "key": "Graphics"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Macintosh HD"
    },
    "break",
    "colors"
  ]
}
